<div class="admin-title">
  <!-- Avatar -->
  <div class="dashboard-avatar-wrap">
    <div class="dashboard-avatar" id="avatar-preview-wrap">
      <% if (avatarUrl) { %>
        <img src="<%= avatarUrl %>" alt="avatar" id="avatar-img" />
      <% } else { %>
        <div class="avatar-placeholder-large" id="avatar-placeholder"><%= username[0].toUpperCase() %></div>
      <% } %>
    </div>
    <label for="avatar-input" class="avatar-upload-btn" title="Zmień zdjęcie profilowe">✎</label>
    <input type="file" id="avatar-input" accept="image/jpeg,image/png,image/webp" style="display:none" />
  </div>

  <div class="dashboard-header-text">
    <h2>Witaj, <%= username %>!</h2>
    <a href="/profile/<%= username %>" class="profile-link">Zobacz swój profil publiczny →</a>
  </div>

  <div class="dashboard-stats">
    <div class="stat-chip">🎬 Ocenione: <strong><%= ratedMoviesCount %></strong></div>
    <div class="stat-chip">✓ Obejrzane: <strong><%= watchedCount %></strong></div>
    <div class="stat-chip">⏱ Do obejrzenia: <strong><%= watchlistCount %></strong></div>
    <div class="stat-chip">♥ Ulubione: <strong><%= favouritesCount %></strong></div>
  </div>

  <div class="dashboard-actions">
    <button id="reset-password-btn">Resetuj hasło</button>
    <button id="delete-account-btn">Usuń konto</button>
  </div>

  <!-- Modals -->
  <div id="reset-password-modal" class="modal" style="display: none">
    <div class="modal-content">
      <span class="close" id="close-reset">&times;</span>
      <h2>Resetuj hasło</h2>
      <form id="reset-password-form" action="/reset-password" method="POST">
        <label for="new-password">Nowe hasło:</label>
        <input type="password" id="new-password" name="newPassword" required />
        <button type="submit" id="confirm-reset-password" class="btn">Zresetuj hasło</button>
      </form>
    </div>
  </div>

  <div id="delete-account-modal" class="modal" style="display: none">
    <div class="modal-content">
      <span class="close" id="close-delete">&times;</span>
      <h2>Usuń konto</h2>
      <p>Czy na pewno chcesz usunąć swoje konto? To działanie jest nieodwracalne.</p>
      <button id="confirm-delete-account" class="btn btn-delete">Potwierdź usunięcie</button>
    </div>
  </div>
</div>

<!-- Zakładki -->
<div class="dashboard-tabs">
  <button class="tab-btn active" data-tab="rated">Oceny (<%= ratedMoviesCount %>)</button>
  <button class="tab-btn" data-tab="watched">Obejrzane (<%= watchedCount %>)</button>
  <button class="tab-btn" data-tab="watchlist">Do obejrzenia (<%= watchlistCount %>)</button>
  <button class="tab-btn" data-tab="favourites">Ulubione (<%= favouritesCount %>)</button>
</div>

<!-- Oceny -->
<div class="tab-content active" id="tab-rated">
  <% if (ratings.length === 0) { %>
    <p class="empty-tab">Nie oceniłeś jeszcze żadnego filmu.</p>
  <% } else { %>
  <div class="review-grid">
    <% ratings.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
          <div class="stars"><%- '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating) %></div>
          <% if (r.comment) { %><p class="review-comment">"<%= r.comment %>"</p><% } %>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Obejrzane -->
<div class="tab-content" id="tab-watched">
  <% if (watched.length === 0) { %>
    <p class="empty-tab">Brak filmów oznaczonych jako obejrzane.</p>
  <% } else { %>
  <div class="review-grid">
    <% watched.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
          <% if (r.watchedDate) { %>
          <p class="watched-date">📅 <%= new Date(r.watchedDate).toLocaleDateString('pl-PL') %></p>
          <% } %>
          <% if (r.runtime) { %>
          <p class="runtime">⏱ <%= r.runtime %> min</p>
          <% } %>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Do obejrzenia -->
<div class="tab-content" id="tab-watchlist">
  <% if (watchlist.length === 0) { %>
    <p class="empty-tab">Twoja lista "Do obejrzenia" jest pusta.</p>
  <% } else { %>
  <div class="review-grid">
    <% watchlist.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
          <% if (r.runtime) { %><p class="runtime">⏱ <%= r.runtime %> min</p><% } %>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Ulubione -->
<div class="tab-content" id="tab-favourites">
  <% if (favourites.length === 0) { %>
    <p class="empty-tab">Nie masz jeszcze żadnych ulubionych filmów.</p>
  <% } else { %>
  <div class="review-grid">
    <% favourites.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<script type="text/javascript" defer src="/js/dashboard.js"></script>
