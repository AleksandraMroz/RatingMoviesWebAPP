<div class="admin-title">
  <!-- Avatar -->
  <div class="dashboard-avatar-wrap">
    <div class="dashboard-avatar" id="avatar-preview-wrap">
      <% if (avatarUrl) { %>
        <img src="<%= avatarUrl %>" alt="avatar" id="avatar-img" />
      <% } else { %>
        <div class="avatar-placeholder-large" id="avatar-placeholder"><%= username[0].toUpperCase() %></div>
      <% } %>
    </div>
    <label for="avatar-input" class="avatar-upload-btn" title="Zmień zdjęcie profilowe">✎</label>
    <input type="file" id="avatar-input" accept="image/jpeg,image/png,image/webp" style="display:none" />
  </div>

  <div class="dashboard-header-text">
    <h2>Witaj, <%= username %>!</h2>
    <a href="/profile/<%= username %>" class="profile-link">Zobacz swój profil publiczny →</a>
  </div>

  <div class="dashboard-stats">
    <div class="stat-chip">Ocenione: <strong><%= ratedMoviesCount %></strong></div>
    <div class="stat-chip">✓ Obejrzane: <strong><%= watchedCount %></strong></div>
    <div class="stat-chip">Do obejrzenia: <strong><%= watchlistCount %></strong></div>
    <div class="stat-chip">♥ Ulubione: <strong><%= favouritesCount %></strong></div>
  </div>

  <div class="dashboard-actions">
    <button id="reset-password-btn">Resetuj hasło</button>
    <button id="delete-account-btn">Usuń konto</button>
  </div>

  <!-- Modals -->
  <div id="reset-password-modal" class="modal" style="display: none">
    <div class="modal-content">
      <span class="close" id="close-reset">&times;</span>
      <h2>Resetuj hasło</h2>
      <form id="reset-password-form" action="/reset-password" method="POST">
        <label for="old-password">Stare hasło:</label>
        <div class="modal-pwd-wrap">
          <input type="password" id="old-password" name="oldPassword" required />
          <button type="button" class="modal-eye-btn" onclick="toggleModalPwd('old-password',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
        <label for="new-password">Nowe hasło:</label>
        <div class="modal-pwd-wrap">
          <input type="password" id="new-password" name="newPassword" required />
          <button type="button" class="modal-eye-btn" onclick="toggleModalPwd('new-password',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
        <button type="submit" id="confirm-reset-password" class="btn">Zresetuj hasło</button>
      </form>
    </div>
  </div>

  <div id="delete-account-modal" class="modal" style="display: none">
    <div class="modal-content">
      <span class="close" id="close-delete">&times;</span>
      <h2>Usuń konto</h2>
      <p>Czy na pewno chcesz usunąć swoje konto? To działanie jest nieodwracalne.</p>
      <button id="confirm-delete-account" class="btn btn-delete">Potwierdź usunięcie</button>
    </div>
  </div>
</div>

<!-- Osiągnięcia -->
<% if (locals.achievements && achievements.length) { %>
<div class="achievements-bar">
  <div class="achievements-bar-header" id="ach-toggle" onclick="document.getElementById('ach-chips').classList.toggle('ach-open')">
    <span>Osiągnięcia (<%= achievements.filter(a=>a.unlocked).length %>/<%= achievements.length %>)</span>
    <span class="ach-arrow">›</span>
  </div>
  <div class="achievements-chips-scroll" id="ach-chips">
    <% [...achievements].sort((a,b) => b.unlocked - a.unlocked).forEach(a => { %>
    <div class="achievement-chip <%= a.unlocked ? 'unlocked' : 'locked' %>" title="<%= a.desc %>">
      <span class="achievement-icon"><%= a.icon %></span>
      <span class="achievement-name"><%= a.name %></span>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- Zakładki -->
<div class="dashboard-tabs">
  <button class="tab-btn active" data-tab="viz">Dashboard</button>
  <button class="tab-btn" data-tab="recommend">Dla Ciebie</button>
  <button class="tab-btn" data-tab="community">Społeczność</button>
  <button class="tab-btn" data-tab="rated">Oceny (<%= ratedMoviesCount %>)</button>
  <button class="tab-btn" data-tab="watched">Obejrzane (<%= watchedCount %>)</button>
  <button class="tab-btn" data-tab="watchlist">Do obejrzenia (<%= watchlistCount %>)</button>
  <button class="tab-btn" data-tab="favourites">Ulubione (<%= favouritesCount %>)</button>
  <button class="tab-btn" data-tab="lists">Moje listy</button>
</div>

<!-- Dashboard D3.js -->
<div class="tab-content active" id="tab-viz">
  <div class="viz-loading" id="viz-loading">Ładowanie danych...</div>

  <!-- Duże liczby -->
  <div class="viz-kpi-row" id="viz-kpis" style="display:none">
    <div class="viz-kpi">
      <span class="viz-kpi-value" id="kpi-hours">—</span>
      <span class="viz-kpi-label">obejrzanych</span>
    </div>
    <div class="viz-kpi">
      <span class="viz-kpi-value" id="kpi-watched">—</span>
      <span class="viz-kpi-label">obejrzanych filmów</span>
    </div>
    <div class="viz-kpi">
      <span class="viz-kpi-value" id="kpi-rated">—</span>
      <span class="viz-kpi-label">ocenionych filmów</span>
    </div>
    <div class="viz-kpi">
      <span class="viz-kpi-value" id="kpi-watchlist">—</span>
      <span class="viz-kpi-label">na liście "Do obejrzenia"</span>
    </div>
  </div>

  <!-- Wiersz 1: Aktywność + Czas miesięcznie -->
  <div class="viz-row" id="viz-charts" style="display:none">
    <div class="viz-card viz-card-full">
      <h4 class="viz-title">Aktywność — ostatnie 12 miesięcy</h4>
      <div id="chart-activity"></div>
    </div>
  </div>

  <div class="viz-row" id="viz-row2" style="display:none">
    <div class="viz-card">
      <h4 class="viz-title">Gatunki filmów</h4>
      <div id="chart-genres"></div>
    </div>
    <div class="viz-card">
      <h4 class="viz-title">Czas oglądania miesięcznie (h)</h4>
      <div id="chart-watchtime"></div>
    </div>
  </div>

  <div class="viz-row" id="viz-row3" style="display:none">
    <div class="viz-card">
      <h4 class="viz-title">Rozkład ocen</h4>
      <div id="chart-ratings-dist"></div>
    </div>
    <div class="viz-card">
      <h4 class="viz-title">Średnia ocena miesięcznie</h4>
      <div id="chart-ratings-time"></div>
    </div>
  </div>

  <div id="viz-empty" class="empty-state" style="display:none;flex-direction:column;align-items:center;text-align:center;padding:48px 16px">
    <h3 style="margin:0 0 8px">Brak danych do wyświetlenia</h3>
    <p style="margin:0;color:var(--gray)">Oznacz kilka filmów jako obejrzane i oceń je, aby zobaczyć swój dashboard.</p>
  </div>
</div>

<!-- Rekomendacje -->
<div class="tab-content" id="tab-recommend">
  <div class="recommend-loading">Ładowanie rekomendacji...</div>
  <div id="recommend-content" style="display:none">
    <div class="viz-row">
      <div class="recommend-section" style="flex:1">
        <h3 class="section-subtitle">Polecane dla Ciebie</h3>
        <p class="section-desc" id="recommend-desc"></p>
        <div id="recommend-grid" class="recommend-grid"></div>
      </div>
      <div class="recommend-section similar-section">
        <h3 class="section-subtitle">Podobni kinomani</h3>
        <p class="section-desc">Użytkownicy o zbliżonym guście filmowym</p>
        <div id="similar-users-list"></div>
      </div>
    </div>
  </div>
</div>

<!-- Społeczność -->
<div class="tab-content" id="tab-community">
  <div class="community-loading">Ładowanie statystyk...</div>
  <div id="community-content" style="display:none">
    <div class="viz-kpi-row community-kpi-row">
      <div class="viz-kpi">
        <span class="viz-kpi-value" id="c-my-avg">—</span>
        <span class="viz-kpi-label">Twoja śr. ocena</span>
      </div>
      <div class="viz-kpi">
        <span class="viz-kpi-value" id="c-comm-avg">—</span>
        <span class="viz-kpi-label">Śr. ocena społeczności</span>
      </div>
      <div class="viz-kpi">
        <span class="viz-kpi-value" id="c-my-hours">—</span>
        <span class="viz-kpi-label">Twoje godziny</span>
      </div>
      <div class="viz-kpi">
        <span class="viz-kpi-value" id="c-avg-hours">—</span>
        <span class="viz-kpi-label">Śr. godziny użytkownika</span>
      </div>
    </div>
    <div class="viz-row">
      <div class="viz-card">
        <h4 class="viz-title">Rozkład ocen — społeczność</h4>
        <div id="chart-community-dist"></div>
      </div>
      <div class="viz-card">
        <h4 class="viz-title">Top gatunki społeczności</h4>
        <div id="chart-community-genres"></div>
      </div>
    </div>
  </div>
</div>

<!-- Oceny -->
<div class="tab-content" id="tab-rated">
  <% if (ratings.length === 0) { %>
    <p class="empty-tab">Nie oceniłeś jeszcze żadnego filmu.</p>
  <% } else { %>
  <div class="review-grid">
    <% ratings.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
          <div class="stars"><%- '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating) %></div>
          <% if (r.comment) { %><p class="review-comment">"<%= r.comment %>"</p><% } %>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Obejrzane -->
<div class="tab-content" id="tab-watched">
  <% if (watched.length === 0) { %>
    <p class="empty-tab">Brak filmów oznaczonych jako obejrzane.</p>
  <% } else { %>
  <div class="review-grid">
    <% watched.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
          <% if (r.watchedDate) { %>
          <p class="watched-date"><%= new Date(r.watchedDate).toLocaleDateString('pl-PL') %></p>
          <% } %>
          <% if (r.runtime) { %>
          <p class="runtime"><%= r.runtime %> min</p>
          <% } %>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Do obejrzenia -->
<div class="tab-content" id="tab-watchlist">
  <% if (watchlist.length === 0) { %>
    <p class="empty-tab">Twoja lista "Do obejrzenia" jest pusta.</p>
  <% } else { %>
  <div class="review-grid">
    <% watchlist.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
          <% if (r.runtime) { %><p class="runtime"><%= r.runtime %> min</p><% } %>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Ulubione -->
<div class="tab-content" id="tab-favourites">
  <% if (favourites.length === 0) { %>
    <p class="empty-tab">Nie masz jeszcze żadnych ulubionych filmów.</p>
  <% } else { %>
  <div class="review-grid">
    <% favourites.forEach(r => { %>
    <a href="/movies/details?movieId=<%= r.movieId %>" class="review-card-link">
      <div class="review-card">
        <img src="https://image.tmdb.org/t/p/w300<%= r.posterPath %>" alt="<%= r.movieTitle %>" />
        <div class="review-content">
          <h4><%= r.movieTitle %></h4>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Moje listy -->
<div class="tab-content" id="tab-lists">
  <div class="lists-toolbar">
    <button class="btn" id="create-list-btn">+ Nowa lista</button>
  </div>

  <!-- Formularz nowej listy -->
  <div id="create-list-form" class="create-list-form" style="display:none">
    <input type="text" id="list-name-input" placeholder="Nazwa listy (np. Top 10 horrorów)" maxlength="80" />
    <textarea id="list-desc-input" placeholder="Opis (opcjonalnie)" rows="2"></textarea>
    <label class="list-public-toggle">
      <input type="checkbox" id="list-public-check" checked />
      <span>Lista publiczna (widoczna na profilu)</span>
    </label>
    <div style="display:flex;gap:8px;">
      <button class="btn" id="save-list-btn">Zapisz listę</button>
      <button class="btn btn-ghost" id="cancel-list-btn">Anuluj</button>
    </div>
  </div>

  <div id="lists-container" class="lists-container">
    <p class="lists-loading">Ładowanie list...</p>
  </div>
</div>

<script type="text/javascript" defer src="/js/dashboard.js"></script>
<script>
function toggleModalPwd(id, btn) {
  const el = document.getElementById(id);
  el.type = el.type === 'text' ? 'password' : 'text';
  btn.innerHTML = el.type === 'text' ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24M1 1l22 22"/></svg>' : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
}
</script>
