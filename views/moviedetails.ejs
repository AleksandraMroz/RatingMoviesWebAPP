<% if (locals.rated) { %>
<div class="rating-toast" id="rating-toast">
  Ocena została zapisana!
  <button onclick="document.getElementById('rating-toast').remove()">×</button>
</div>
<script>setTimeout(()=>{const t=document.getElementById('rating-toast');if(t)t.classList.add('toast-hide');},4000);</script>
<% } %>

<div class="movie-details-page">
  <div class="movie-info">
    <div class="movie-details">
      <img
        src="https://image.tmdb.org/t/p/w300<%= movie.poster_path %>"
        alt="<%= movie.title %>"
      />
    </div>
    <div class="movie-meta-block">
      <h1 class="movie-title"><%= movie.title %></h1>
      <p class="movie-meta">
        Premiera: <%= movie.release_date %>
        <% if (movie.runtime) { %> &bull; <%= movie.runtime %> min<% } %>
      </p>
      <p><%= movie.overview %></p>
      <h3>Obsada:</h3>
      <ul class="cast-list">
        <% if (movie.credits && movie.credits.cast) { %>
          <% movie.credits.cast.slice(0, 8).forEach(actor => { %>
          <li><strong><%= actor.name %></strong> jako <%= actor.character %></li>
          <% }) %>
        <% } else { %>
          <li>Brak dostępnych informacji o obsadzie.</li>
        <% } %>
      </ul>
      <!-- Status i ulubione -->
      <div class="watch-status-buttons" id="detail-actions" data-movie-id="<%= movie.id %>">
        <button class="status-btn" id="detail-btn-watched" data-status="watched">&#10003; Obejrzane</button>
        <button class="status-btn" id="detail-btn-watchlist" data-status="watchlist">Do obejrzenia</button>
        <button class="status-btn status-btn-fav" id="detail-btn-fav" data-status="favourite">&#9829; Ulubione</button>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px">
        <button class="btn" id="detail-rate-btn" data-movie-id="<%= movie.id %>" data-movie-title="<%= movie.title.replace(/"/g, '&quot;') %>">Oceń ten film</button>
        <button class="btn btn-ghost" id="detail-add-list-btn">Dodaj do listy</button>
      </div>
    </div>
  </div>

<!-- Modal: Dodaj do listy -->
<div id="detail-list-modal" class="modal" style="display:none">
  <div class="modal-content">
    <span class="close" id="close-detail-list-modal">&times;</span>
    <h2>Dodaj do listy</h2>
    <div id="detail-list-modal-body">Ładowanie list...</div>
    <hr style="margin:16px 0;border-color:var(--gray-light)"/>
    <div class="list-quick-create">
      <h4>Utwórz nową listę</h4>
      <input type="text" id="detail-quick-list-name" placeholder="Nazwa listy" maxlength="80" />
      <button class="btn" id="detail-quick-create-list-btn">Utwórz i dodaj</button>
    </div>
  </div>
</div>

<script>
(function(){
  const movieId = "<%= movie.id %>";
  const watched = document.getElementById("detail-btn-watched");
  const watchlist = document.getElementById("detail-btn-watchlist");
  const fav = document.getElementById("detail-btn-fav");

  // Pobierz aktualny status
  fetch("/my-status/" + movieId, { credentials: "same-origin" })
    .then(r => r.ok ? r.json() : null)
    .then(data => {
      if (!data) return;
      if (data.watchStatus === "watched") watched.classList.add("active");
      if (data.watchStatus === "watchlist") watchlist.classList.add("active");
      if (data.isFavourite) fav.classList.add("active");
    }).catch(()=>{});

  function setStatus(status) {
    // Toggle: jeśli już aktywny → wyślij "none" żeby odklikać
    let sendStatus = status;
    if (status === "watched" && watched.classList.contains("active")) sendStatus = "none";
    else if (status === "watchlist" && watchlist.classList.contains("active")) sendStatus = "none";
    else if (status === "favourite") sendStatus = fav.classList.contains("active") ? "unfavourite" : "favourite";

    fetch("/set-watch-status", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ movieId, status: sendStatus }),
      credentials: "same-origin"
    }).then(r => {
      if (r.status === 401) { window.location.href = "/admin"; return; }
      if (r.ok) {
        if (sendStatus === "watched") { watched.classList.add("active"); watchlist.classList.remove("active"); }
        else if (sendStatus === "watchlist") { watchlist.classList.add("active"); watched.classList.remove("active"); }
        else if (sendStatus === "none") { watched.classList.remove("active"); watchlist.classList.remove("active"); }
        else if (sendStatus === "favourite") { fav.classList.add("active"); }
        else if (sendStatus === "unfavourite") { fav.classList.remove("active"); }
      }
    });
  }

  watched.onclick = () => setStatus("watched");
  watchlist.onclick = () => setStatus("watchlist");
  fav.onclick = () => setStatus("favourite");

  // Przycisk "Oceń ten film" → otwiera globalny modal
  document.getElementById("detail-rate-btn").onclick = function() {
    const modal = document.getElementById("rate-modal");
    if (!modal) { window.location.href = "/movies/rate?movieId=" + movieId; return; }
    document.getElementById("rate-modal-movie-id").value = movieId;
    document.getElementById("rate-modal-title").textContent = this.dataset.movieTitle || "Oceń film";
    document.getElementById("rate-modal-rating").value = "0";
    document.getElementById("rate-modal-comment").value = "";
    document.querySelectorAll("#rate-modal-stars .star-pick").forEach(s => s.classList.remove("active"));
    modal.style.display = "block";
  };

  // Dodaj do listy
  const listModal = document.getElementById("detail-list-modal");
  const listBody = document.getElementById("detail-list-modal-body");
  document.getElementById("detail-add-list-btn").onclick = async function() {
    listBody.innerHTML = "Ładowanie list...";
    listModal.style.display = "block";
    const res = await fetch("/lists", { credentials: "same-origin" });
    if (res.status === 401) { window.location.href = "/admin"; return; }
    const lists = await res.json();
    listBody.innerHTML = lists.length
      ? lists.map(l => `<button class="btn btn-ghost detail-add-to-list-item" style="width:100%;margin-bottom:6px;text-align:left" data-list="${l._id}">${l.name} (${l.movies.length} filmów)</button>`).join("")
      : "<p>Nie masz jeszcze żadnych list.</p>";
    listBody.querySelectorAll(".detail-add-to-list-item").forEach(btn => {
      btn.onclick = async () => {
        await fetch(`/lists/${btn.dataset.list}/movies`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ movieId, movieTitle: "<%= movie.title.replace(/"/g, '\\\"') %>", posterPath: "<%= movie.poster_path %>" }),
          credentials: "same-origin"
        });
        listModal.style.display = "none";
        const t = document.createElement("div");
        t.className = "toast toast-success"; t.textContent = "Dodano do listy";
        document.body.appendChild(t);
        setTimeout(() => t.classList.add("toast-show"), 10);
        setTimeout(() => { t.classList.remove("toast-show"); setTimeout(() => t.remove(), 400); }, 2500);
      };
    });
  };
  document.getElementById("close-detail-list-modal").onclick = () => { listModal.style.display = "none"; };
  window.addEventListener("click", e => { if (e.target === listModal) listModal.style.display = "none"; });

  document.getElementById("detail-quick-create-list-btn").onclick = async () => {
    const name = document.getElementById("detail-quick-list-name").value.trim();
    if (!name) return;
    const res = await fetch("/lists", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, isPublic: false }), credentials: "same-origin" });
    const newList = await res.json();
    await fetch(`/lists/${newList._id}/movies`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ movieId, movieTitle: "<%= movie.title.replace(/"/g, '\\\"') %>", posterPath: "<%= movie.poster_path %>" }),
      credentials: "same-origin"
    });
    listModal.style.display = "none";
    const t = document.createElement("div"); t.className = "toast toast-success"; t.textContent = "Lista utworzona i film dodany";
    document.body.appendChild(t); setTimeout(() => t.classList.add("toast-show"), 10);
    setTimeout(() => { t.classList.remove("toast-show"); setTimeout(() => t.remove(), 400); }, 2500);
  };
})();
</script>

  <!-- Oceny użytkowników -->
  <% if (publicReviews && publicReviews.length > 0) { %>
  <div class="public-reviews">
    <h3>Oceny użytkowników (<%= publicReviews.length %>)</h3>
    <div class="public-reviews-list">
      <% publicReviews.forEach(r => { %>
      <div class="public-review-card">
        <div class="reviewer-info">
          <div class="reviewer-avatar">
            <% if (r.user && r.user.avatarUrl) { %>
              <img src="<%= r.user.avatarUrl %>" alt="<%= r.user.username %>" />
            <% } else { %>
              <div class="avatar-placeholder"><%= r.user ? r.user.username[0].toUpperCase() : '?' %></div>
            <% } %>
          </div>
          <a href="/profile/<%= r.user ? r.user.username : '' %>" class="reviewer-name"><%= r.user ? r.user.username : 'Użytkownik' %></a>
        </div>
        <div class="reviewer-rating">
          <span class="stars"><%- '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating) %></span>
          <span class="rating-number"><%= r.rating %>/5</span>
        </div>
        <% if (r.comment) { %>
        <p class="reviewer-comment">"<%= r.comment %>"</p>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
  <% } else { %>
  <p class="no-reviews">Brak ocen dla tego filmu. Bądź pierwszy!</p>
  <% } %>
</div>
