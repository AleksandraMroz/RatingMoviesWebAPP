<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">🎬 Filmoteka</span>
      <p class="footer-tagline">Twój osobisty dziennik kinomana</p>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h5>Odkryj</h5>
        <a href="/">Strona główna</a>
        <a href="/discover">Ranking użytkowników</a>
        <a href="/movies">Filmy</a>
      </div>
      <div class="footer-col">
        <h5>Konto</h5>
        <% if (locals.username) { %>
          <a href="/dashboard">Mój dashboard</a>
          <a href="/profile/<%= locals.username %>">Mój profil</a>
          <a href="/following">Obserwowane</a>
        <% } else { %>
          <a href="/login">Logowanie</a>
          <a href="/register">Rejestracja</a>
        <% } %>
      </div>
      <div class="footer-col">
        <h5>Projekt</h5>
        <span>Praca inżynierska 2025</span>
        <span>Node.js · MongoDB · D3.js</span>
        <span>Dane: TMDB API</span>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; <%= new Date().getFullYear() %> Aleksandra Mróz, Michał Bujak, Robert Dąbrowski</span>
    <span class="footer-sep">·</span>
    <span>Napędzane przez <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">TMDB</a></span>
  </div>
</footer>
